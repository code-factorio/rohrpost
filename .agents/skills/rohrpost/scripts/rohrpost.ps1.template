# Rohrpost launcher for PowerShell, materialised from rohrpost.ps1.template.
# The wrapper validates the local installation and never bypasses it: it only
# ever runs the rp executable from the install's own .venv.
#
# No placeholder to substitute: the default home resolves %LOCALAPPDATA%\rohrpost
# at runtime and ROHRPOST_HOME overrides it.

if (-not $env:ROHRPOST_HOME -and -not $env:LOCALAPPDATA) {
    [Console]::Error.WriteLine('Rohrpost is not installed: neither ROHRPOST_HOME nor LOCALAPPDATA is set')
    [Console]::Error.WriteLine('Load .agents/skills/rohrpost/playbooks/install-local.md to provision it')
    exit 1
}

$rohrpostHome = if ($env:ROHRPOST_HOME) { $env:ROHRPOST_HOME } else { Join-Path $env:LOCALAPPDATA 'rohrpost' }
$rohrpostSource = Join-Path $rohrpostHome 'src'

if (-not (Test-Path -LiteralPath $rohrpostSource -PathType Container)) {
    [Console]::Error.WriteLine("Rohrpost is not installed: source checkout is missing at $rohrpostSource")
    [Console]::Error.WriteLine('Load .agents/skills/rohrpost/playbooks/install-local.md to provision it')
    exit 1
}

$rohrpostExecutable = ''
foreach ($candidate in @(
    (Join-Path $rohrpostSource '.venv\Scripts\rp.exe'),
    (Join-Path $rohrpostSource '.venv\Scripts\rp')
)) {
    if (Test-Path -LiteralPath $candidate -PathType Leaf) {
        $rohrpostExecutable = $candidate
        break
    }
}

if (-not $rohrpostExecutable) {
    [Console]::Error.WriteLine("Rohrpost is not installed: local executable is missing under $rohrpostSource\.venv")
    [Console]::Error.WriteLine('Load .agents/skills/rohrpost/playbooks/install-local.md to provision it')
    exit 1
}

& $rohrpostExecutable @args
exit $LASTEXITCODE
